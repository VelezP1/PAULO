<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Paulo Velez — Athlete-Designer</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@300;400;500&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
  <style>
    :root {
      --black: #0a0a0a;
      --paper: #e8e6e1;
      --maguey: #c45c3e;
      --ice: #a8c4c4;
      --mono: 'IBM Plex Mono', monospace;
      --sans: 'Inter', sans-serif;
      --serif: 'Playfair Display', Georgia, serif;
      --ease: cubic-bezier(0.22, 1, 0.36, 1);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html {
      scroll-behavior: smooth;
      background: var(--black);
    }

    body {
      font-family: var(--sans);
      font-size: 16px;
      letter-spacing: 0.02em;
      line-height: 1.5;
      color: var(--paper);
      background: var(--black);
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
      cursor: none;
    }

    @media (pointer: coarse) { body { cursor: auto; } }

    ::selection { background: var(--maguey); color: var(--black); }

    /* Custom cursor */
    .cursor {
      position: fixed;
      width: 12px;
      height: 12px;
      border: 1px solid var(--paper);
      border-radius: 50%;
      pointer-events: none;
      z-index: 10000;
      transform: translate(-50%, -50%);
      transition: width 0.25s ease, height 0.25s ease, background 0.25s ease, border-color 0.25s ease;
      mix-blend-mode: difference;
    }
    .cursor.hover {
      width: 48px;
      height: 48px;
      background: var(--paper);
      border-color: transparent;
    }

    /* Grain */
    .grain {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 9999;
      opacity: 0.07;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
      animation: grainShift 0.5s steps(10) infinite;
      mix-blend-mode: overlay;
    }
    @keyframes grainShift {
      0%,100% { transform: translate(0,0); }
      20% { transform: translate(-2%,1%); }
      40% { transform: translate(1%,-2%); }
      60% { transform: translate(-1%,2%); }
      80% { transform: translate(2%,-1%); }
    }

    .display { font-family: var(--serif); letter-spacing: -0.035em; line-height: 0.9; font-weight: 600; }
    .meta { font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.1em; color: rgba(232,230,225,0.5); }

    /* Reveals */
    .reveal { opacity: 0; transform: translateY(40px); transition: opacity 0.8s var(--ease), transform 0.8s var(--ease); }
    .reveal.in-view { opacity: 1; transform: translateY(0); }

    /* Nav */
    .nav {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 1000;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.5rem 2rem;
      mix-blend-mode: difference;
    }
    .nav__mark { font-family: var(--serif); font-size: 1.3rem; letter-spacing: -0.04em; font-weight: 600; color: var(--paper); text-decoration: none; }
    .nav__right { display: flex; align-items: center; gap: 1.25rem; }
    .issue { font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--paper); }
    .audio-toggle { width: 14px; height: 14px; border-radius: 50%; border: 1px solid var(--paper); background: transparent; cursor: pointer; transition: background 0.3s ease; }
    .audio-toggle.active { background: var(--paper); }

    /* HERO */
    .hero {
      position: relative;
      min-height: 100vh;
      display: grid;
      grid-template-columns: 55% 45%;
      background: var(--black);
      overflow: hidden;
    }

    .hero__image-wrap {
      position: relative;
      height: 100vh;
      overflow: hidden;
    }
    .hero__image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
      transform: scale(1.05);
      transition: transform 0.1s linear;
    }
    .hero__image-wrap::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, transparent 60%, var(--black) 100%);
    }

    .hero__content {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 5rem 4rem 4rem 2rem;
      position: relative;
      z-index: 2;
    }

    .hero__kicker { margin-bottom: 1rem; }

    .hero__headline {
      font-family: var(--serif);
      font-size: clamp(3rem, 7vw, 7rem);
      letter-spacing: -0.04em;
      line-height: 0.88;
      font-weight: 600;
      text-transform: uppercase;
      min-height: 1.1em;
    }

    .hero__caption {
      margin-top: 2rem;
      max-width: 380px;
      font-size: 0.95rem;
      line-height: 1.6;
      color: rgba(232,230,225,0.7);
    }

    .hero__line {
      margin-top: 2.5rem;
      height: 2px;
      width: 100%;
      max-width: 400px;
      background: linear-gradient(90deg, var(--maguey), var(--ice));
    }

    /* Scramble cursor */
    .hero__headline .cursor-char { display: inline-block; }

    /* IDENTITY STRIP */
    .identity {
      padding: 5rem 0;
      background: var(--black);
      overflow: hidden;
      border-top: 1px solid rgba(232,230,225,0.08);
      border-bottom: 1px solid rgba(232,230,225,0.08);
    }
    .identity__marquee {
      display: flex;
      gap: 3rem;
      width: max-content;
      animation: marquee 20s linear infinite;
    }
    .identity__marquee:hover { animation-play-state: paused; }
    @keyframes marquee {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }
    .identity__word {
      font-family: var(--serif);
      font-size: clamp(3rem, 10vw, 9rem);
      letter-spacing: -0.04em;
      text-transform: uppercase;
      white-space: nowrap;
      color: transparent;
      -webkit-text-stroke: 1px rgba(232,230,225,0.35);
      transition: color 0.3s ease;
    }
    .identity__word:hover { color: var(--paper); -webkit-text-stroke: 1px var(--paper); }

    /* VISUAL TIMELINE */
    .timeline {
      padding: 8rem 2rem;
      background: var(--black);
    }
    .timeline__header { margin: 0 0 4rem 6vw; }
    .timeline__title { font-family: var(--serif); font-size: clamp(2.5rem, 6vw, 5rem); letter-spacing: -0.03em; }

    .timeline__list {
      display: flex;
      flex-direction: column;
      gap: 0;
      max-width: 1200px;
      margin: 0 auto;
    }
    .timeline__item {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      border-top: 1px solid rgba(232,230,225,0.1);
      padding: 2.5rem 0;
      transition: background 0.3s ease;
    }
    .timeline__item:hover { background: rgba(255,255,255,0.02); }
    .timeline__item:last-child { border-bottom: 1px solid rgba(232,230,225,0.1); }
    .timeline__item:nth-child(even) .timeline__visual { order: 2; }
    .timeline__item:nth-child(even) .timeline__text { order: 1; padding-left: 0; padding-right: 3rem; text-align: right; }

    .timeline__visual {
      position: relative;
      overflow: hidden;
      aspect-ratio: 16/10;
    }
    .timeline__visual img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.6s var(--ease);
    }
    .timeline__item:hover .timeline__visual img { transform: scale(1.06); }

    .timeline__text { padding-left: 3rem; }
    .timeline__coords { display: block; margin-bottom: 0.75rem; }
    .timeline__city { font-family: var(--serif); font-size: clamp(2rem, 4vw, 3.2rem); letter-spacing: -0.03em; line-height: 1; margin-bottom: 0.75rem; }
    .timeline__body { max-width: 360px; font-size: 0.92rem; line-height: 1.55; color: rgba(232,230,225,0.65); }
    .timeline__item:nth-child(even) .timeline__body { margin-left: auto; }

    /* LOGO WALL */
    .logos {
      padding: 6rem 2rem;
      background: var(--paper);
      color: var(--black);
    }
    .logos__title { font-family: var(--serif); font-size: clamp(2rem, 5vw, 3.5rem); letter-spacing: -0.03em; text-align: center; margin-bottom: 3rem; color: var(--black); }
    .logos__grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 2rem;
      max-width: 1000px;
      margin: 0 auto;
      align-items: center;
      justify-items: center;
    }
    .logo-card {
      width: 100%;
      max-width: 180px;
      aspect-ratio: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid rgba(10,10,10,0.1);
      padding: 1.5rem;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      background: rgba(255,255,255,0.4);
    }
    .logo-card:hover { transform: translateY(-6px); box-shadow: 0 20px 40px rgba(0,0,0,0.12); }
    .logo-card img { max-width: 100%; max-height: 80px; object-fit: contain; }

    /* PROJECTS */
    .projects {
      padding: 8rem 0;
      background: var(--black);
      overflow: hidden;
    }
    .projects__header { padding: 0 2rem 3rem 6vw; }
    .projects__title { font-family: var(--serif); font-size: clamp(2.5rem, 6vw, 5rem); letter-spacing: -0.03em; }
    .projects__track {
      display: flex;
      gap: 1.5rem;
      padding: 1rem 6vw 3rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: thin;
      scrollbar-color: var(--maguey) transparent;
    }
    .projects__track::-webkit-scrollbar { height: 3px; }
    .projects__track::-webkit-scrollbar-thumb { background: var(--maguey); }

    .project-card {
      flex: 0 0 auto;
      width: clamp(300px, 40vw, 520px);
      aspect-ratio: 4/5;
      position: relative;
      perspective: 1000px;
      scroll-snap-align: start;
      text-decoration: none;
      color: inherit;
      overflow: hidden;
    }
    .project-card__inner {
      width: 100%;
      height: 100%;
      position: relative;
      transform-style: preserve-3d;
      transition: transform 0.2s ease-out;
    }
    .project-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.6s var(--ease);
    }
    .project-card:hover img { transform: scale(1.05); }
    .project-card__overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, transparent 40%, rgba(10,10,10,0.85) 100%);
    }
    .project-card__scan {
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(10,10,10,0.25) 2px, rgba(10,10,10,0.25) 5px);
      opacity: 0.25;
      pointer-events: none;
    }
    .project-card__info {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 1.5rem;
      z-index: 2;
    }
    .project-card__name { font-family: var(--serif); font-size: 2rem; letter-spacing: -0.03em; line-height: 1; }
    .project-card__subtitle { font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ice); margin-top: 0.4rem; }

    /* SKILLS */
    .skills {
      padding: 8rem 2rem;
      background: var(--black);
    }
    .skills__grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      max-width: 1100px;
      margin: 0 auto;
    }
    .skills__block { padding: 2rem; border: 1px solid rgba(232,230,225,0.1); }
    .skills__title { font-family: var(--serif); font-size: clamp(1.8rem, 4vw, 2.4rem); letter-spacing: -0.03em; margin-bottom: 1.5rem; }
    .skills__list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      list-style: none;
    }
    .skills__list li {
      font-family: var(--mono);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      padding: 0.5rem 1rem;
      border: 1px solid rgba(232,230,225,0.2);
      transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease;
    }
    .skills__list li:hover { background: var(--paper); color: var(--black); border-color: var(--paper); }

    .contact p { font-size: 0.95rem; line-height: 2; color: rgba(232,230,225,0.7); }
    .contact a { color: var(--paper); text-decoration: none; border-bottom: 1px solid transparent; transition: border-color 0.3s ease; }
    .contact a:hover { border-color: var(--maguey); }

    /* FOOTER */
    .footer {
      padding: 5rem 2rem 7rem;
      background: var(--black);
      display: flex;
      justify-content: center;
    }
    .colophon {
      width: 45%;
      min-width: 280px;
      text-align: center;
      font-family: var(--mono);
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      line-height: 2;
      color: rgba(232,230,225,0.5);
    }
    .colophon__mark { font-family: var(--serif); font-size: 1.6rem; letter-spacing: -0.04em; color: var(--paper); display: block; margin-bottom: 1.5rem; }
    .colophon__links { display: flex; justify-content: center; gap: 1.5rem; margin-top: 1.5rem; }
    .colophon__links a { color: var(--paper); text-decoration: none; border-bottom: 1px solid transparent; transition: border-color 0.3s ease; }
    .colophon__links a:hover { border-color: var(--maguey); }

    @media (max-width: 900px) {
      body { cursor: auto; }
      .cursor { display: none; }
      .hero { grid-template-columns: 1fr; }
      .hero__image-wrap { height: 60vh; }
      .hero__image-wrap::after { background: linear-gradient(180deg, transparent 0%, var(--black) 100%); }
      .hero__content { padding: 2rem; }
      .timeline__item,
      .timeline__item:nth-child(even) { grid-template-columns: 1fr; }
      .timeline__item:nth-child(even) .timeline__visual,
      .timeline__item:nth-child(even) .timeline__text { order: 0; padding: 0; text-align: left; }
      .timeline__text { padding: 1.5rem 0 0; }
      .timeline__item:nth-child(even) .timeline__body { margin-left: 0; }
      .skills__grid { grid-template-columns: 1fr; }
      .colophon { width: 80%; }
    }

    @media (max-width: 600px) {
      .hero__content,
      .projects__header,
      .timeline__header { margin-left: 0; padding-left: 1.5rem; }
    }
  </style>
</head>
<body>
  <div class="cursor" aria-hidden="true"></div>
  <div class="grain" aria-hidden="true"></div>

  <nav class="nav">
    <a href="#" class="nav__mark">Paulo Velez</a>
    <div class="nav__right">
      <span class="issue">Profile / 2026</span>
      <button class="audio-toggle" id="audioToggle" aria-label="Toggle ambient sound"></button>
    </div>
  </nav>

  <!-- HERO -->
  <section class="hero" id="hero">
    <div class="hero__image-wrap">
      <img class="hero__image" src="images/Profile.jpg" alt="Paulo Velez" id="heroImage">
    </div>
    <div class="hero__content">
      <div class="hero__kicker meta reveal">Athlete — Designer — Engineer</div>
      <h1 class="hero__headline display" id="heroHeadline">ATHLETE</h1>
      <p class="hero__caption reveal">
        Engineering student. CalArts designer. Aalto UX. IE entrepreneur. 
        Ballplayer from Puebla. I build systems that move.
      </p>
      <div class="hero__line reveal"></div>
    </div>
  </section>

  <!-- IDENTITY STRIP -->
  <section class="identity" aria-label="Identity">
    <div class="identity__marquee">
      <span class="identity__word">Athlete</span>
      <span class="identity__word">Designer</span>
      <span class="identity__word">Engineer</span>
      <span class="identity__word">Founder</span>
      <span class="identity__word">Athlete</span>
      <span class="identity__word">Designer</span>
      <span class="identity__word">Engineer</span>
      <span class="identity__word">Founder</span>
    </div>
  </section>

  <!-- TIMELINE -->
  <section class="timeline" id="timeline">
    <header class="timeline__header reveal">
      <span class="meta">The Transcript</span>
      <h2 class="timeline__title display">Field Notes</h2>
    </header>
    <div class="timeline__list">
      <article class="timeline__item reveal">
        <div class="timeline__visual">
          <img src="images/Profile.jpg" alt="Puebla">
        </div>
        <div class="timeline__text">
          <span class="timeline__coords meta">19.5433° N, 98.1802° W</span>
          <h3 class="timeline__city display">Puebla</h3>
          <p class="timeline__body">Raised by volcanoes. President of SATI. Planter of maguey. Roots before speed.</p>
        </div>
      </article>
      <article class="timeline__item reveal">
        <div class="timeline__visual">
          <img src="images/Aalto%20university.png" alt="Aalto University">
        </div>
        <div class="timeline__text">
          <span class="timeline__coords meta">60.1699° N, 24.9384° E</span>
          <h3 class="timeline__city display">Helsinki</h3>
          <p class="timeline__body">Human-Centered UX at Aalto. Restraint in the grey. Silence as a design material.</p>
        </div>
      </article>
      <article class="timeline__item reveal">
        <div class="timeline__visual">
          <img src="images/IE_University_logo.svg" alt="IE University">
        </div>
        <div class="timeline__text">
          <span class="timeline__coords meta">40.4168° N, 3.7038° W</span>
          <h3 class="timeline__city display">Madrid</h3>
          <p class="timeline__body">Entrepreneurship bootcamp at IE. Systems that scale. Velocity without mass is noise.</p>
        </div>
      </article>
      <article class="timeline__item reveal">
        <div class="timeline__visual">
          <img src="images/Estudios.png" alt="Tecnológico de Monterrey">
        </div>
        <div class="timeline__text">
          <span class="timeline__coords meta label">Current</span>
          <h3 class="timeline__city display">Monterrey</h3>
          <p class="timeline__body">Ingeniería en Tecnologías Computacionales. Founder of EVRABO MTN. The lab.</p>
        </div>
      </article>
    </div>
  </section>

  <!-- LOGO WALL -->
  <section class="logos" id="education">
    <h2 class="logos__title reveal">Education</h2>
    <div class="logos__grid reveal">
      <div class="logo-card"><img src="images/Estudios.png" alt="Tecnológico de Monterrey"></div>
      <div class="logo-card"><img src="images/Aalto%20university.png" alt="Aalto University"></div>
      <div class="logo-card"><img src="images/IE_University_logo.svg" alt="IE University"></div>
      <div class="logo-card"><img src="images/CalArts.png" alt="CalArts"></div>
      <div class="logo-card"><img src="images/Universidad%20de%20Colorado.webp" alt="University of Colorado"></div>
    </div>
  </section>

  <!-- PROJECTS -->
  <section class="projects" id="projects">
    <header class="projects__header reveal">
      <span class="meta">Selected Work</span>
      <h2 class="projects__title display">Projects</h2>
    </header>
    <div class="projects__track">
      <a class="project-card" href="https://paulovel.github.io/XECOR/" target="_blank" rel="noopener" data-tilt>
        <div class="project-card__inner">
          <img src="images/EVRABO.jpg" alt="EVRABO MTN">
          <div class="project-card__overlay"></div>
          <div class="project-card__scan"></div>
          <div class="project-card__info">
            <h3 class="project-card__name">EVRABO</h3>
            <p class="project-card__subtitle">Downhill Mexico · Founder</p>
          </div>
        </div>
      </a>
      <article class="project-card" data-tilt>
        <div class="project-card__inner">
          <img src="images/experiencia%20Laborar.png" alt="Ecohack Bono">
          <div class="project-card__overlay"></div>
          <div class="project-card__scan"></div>
          <div class="project-card__info">
            <h3 class="project-card__name">Ecohack Bono</h3>
            <p class="project-card__subtitle">Carbon footprint AI · Winner</p>
          </div>
        </div>
      </article>
      <article class="project-card" data-tilt>
        <div class="project-card__inner">
          <img src="images/Road%20TO%20start%20hack.jpeg" alt="Start Hack México">
          <div class="project-card__overlay"></div>
          <div class="project-card__scan"></div>
          <div class="project-card__info">
            <h3 class="project-card__name">Start Hack</h3>
            <p class="project-card__subtitle">Drought in Mexico · Finalist</p>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- SKILLS & CONTACT -->
  <section class="skills" id="skills">
    <div class="skills__grid">
      <div class="skills__block reveal">
        <span class="meta">Technical</span>
        <h2 class="skills__title display">Skills</h2>
        <ul class="skills__list">
          <li>C++</li>
          <li>C# Unity</li>
          <li>Java</li>
          <li>Python</li>
          <li>Matlab</li>
          <li>UX Design</li>
          <li>Graphic Design</li>
          <li>Entrepreneurship</li>
        </ul>
      </div>
      <div class="skills__block reveal contact">
        <span class="meta">Contacto</span>
        <h2 class="skills__title display">Reach Out</h2>
        <p>
          <a href="tel:+522215292879">+52 221 529 2879</a><br>
          <a href="mailto:paulo_velez@outlook.com">paulo_velez@outlook.com</a><br>
          Puebla, México
        </p>
        <p style="margin-top:1.5rem;">Español · English</p>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="footer" id="colophon">
    <div class="colophon reveal">
      <span class="colophon__mark">Paulo Velez</span>
      <p>
        Designed and built by Paulo Velez in Puebla, México.<br>
        Last updated: Agosto 2026
      </p>
      <div class="colophon__links">
        <a href="https://www.instagram.com/paulo_velez_/" target="_blank" rel="noopener">Instagram</a>
        <a href="https://www.tiktok.com/@paulo_velez_?lang=en" target="_blank" rel="noopener">TikTok</a>
        <a href="https://www.linkedin.com/in/paulo-velez-aba132416" target="_blank" rel="noopener">LinkedIn</a>
      </div>
    </div>
  </footer>

  <script>
    /* ─── SCRAMBLE TEXT HEADLINE ─── */
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%&';
    const words = ['ATHLETE', 'DESIGNER', 'ENGINEER', 'FOUNDER'];
    const headline = document.getElementById('heroHeadline');
    let wordIndex = 0;

    function scramble(newText) {
      const oldText = headline.textContent;
      const maxLen = Math.max(oldText.length, newText.length);
      let frame = 0;
      const totalFrames = 24;

      const interval = setInterval(() => {
        let out = '';
        for (let i = 0; i < maxLen; i++) {
          if (i < newText.length) {
            if (frame / totalFrames > i / newText.length) {
              out += newText[i];
            } else {
              out += chars[Math.floor(Math.random() * chars.length)];
            }
          } else {
            out += '';
          }
        }
        headline.textContent = out;
        frame++;
        if (frame > totalFrames) {
          clearInterval(interval);
          headline.textContent = newText;
        }
      }, 30);
    }

    setInterval(() => {
      wordIndex = (wordIndex + 1) % words.length;
      scramble(words[wordIndex]);
    }, 2800);

    /* ─── PARALLAX HERO IMAGE ─── */
    const heroImage = document.getElementById('heroImage');
    window.addEventListener('scroll', () => {
      const y = window.scrollY;
      heroImage.style.transform = `scale(1.05) translateY(${y * 0.12}px)`;
    }, { passive: true });

    /* ─── CUSTOM CURSOR ─── */
    const cursor = document.querySelector('.cursor');
    document.addEventListener('mousemove', (e) => {
      cursor.style.left = e.clientX + 'px';
      cursor.style.top = e.clientY + 'px';
    });
    document.querySelectorAll('a, button, [data-tilt], .logo-card, .timeline__item').forEach(el => {
      el.addEventListener('mouseenter', () => cursor.classList.add('hover'));
      el.addEventListener('mouseleave', () => cursor.classList.remove('hover'));
    });

    /* ─── INTERSECTION OBSERVER ─── */
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) entry.target.classList.add('in-view');
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -60px 0px' });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

    /* ─── 3D CARD TILT ─── */
    document.querySelectorAll('[data-tilt]').forEach(card => {
      const inner = card.querySelector('.project-card__inner');
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const rotateX = ((y - rect.height/2) / (rect.height/2)) * -10;
        const rotateY = ((x - rect.width/2) / (rect.width/2)) * 10;
        inner.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
      });
      card.addEventListener('mouseleave', () => {
        inner.style.transform = 'perspective(1000px) rotateX(0) rotateY(0)';
      });
    });

    /* ─── AUDIO TOGGLE ─── */
    const audioToggle = document.getElementById('audioToggle');
    let audioCtx, isPlaying = false, nodes = [];
    function createNoiseBuffer() {
      const bufferSize = audioCtx.sampleRate * 2;
      const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
      const data = buffer.getChannelData(0);
      for (let i = 0; i < bufferSize; i++) data[i] = (Math.random() * 2 - 1) * 0.08;
      return buffer;
    }
    audioToggle.addEventListener('click', () => {
      isPlaying = !isPlaying;
      audioToggle.classList.toggle('active', isPlaying);
      if (isPlaying) {
        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        if (audioCtx.state === 'suspended') audioCtx.resume();
        const noise = audioCtx.createBufferSource();
        noise.buffer = createNoiseBuffer(); noise.loop = true;
        const filter = audioCtx.createBiquadFilter(); filter.type = 'lowpass'; filter.frequency.value = 180;
        const gain = audioCtx.createGain(); gain.gain.value = 0.08;
        const osc = audioCtx.createOscillator(); osc.type = 'sine'; osc.frequency.value = 58;
        const oscGain = audioCtx.createGain(); oscGain.gain.value = 0.025;
        noise.connect(filter).connect(gain).connect(audioCtx.destination);
        osc.connect(oscGain).connect(audioCtx.destination);
        noise.start(); osc.start();
        nodes = [noise, osc, gain, oscGain];
      } else {
        nodes.forEach(n => { try { n.stop ? n.stop() : n.disconnect(); } catch(e){} });
        nodes = [];
      }
    });
  </script>
</body>
</html>
