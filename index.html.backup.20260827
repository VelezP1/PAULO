<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Jose Paulo Velez Ortiz — Portafolio</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='22' fill='%23050505'/><path d='M28 22h24c14 0 23 8.5 23 20.5S66 63 52 63H42v22H28V22zm14 13v15h9.5c5.8 0 9.5-3.2 9.5-7.5s-3.7-7.5-9.5-7.5H42z' fill='%23ffffff'/><circle cx='76' cy='76' r='8.5' fill='%23d90429'/></svg>">
  <meta name="description" content="Jose Paulo Velez Ortiz — Founder EBRAVO MTN · ITC Tec de Monterrey · UX Aalto University.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,900;1,400;1,700&display=swap" rel="stylesheet">
  <style>
    :root {
      --black:       #050505;
      --black-card:  #0a0a0a;
      --white:       #ffffff;
      --white-dim:   rgba(255,255,255,0.72);
      --white-ghost: rgba(255,255,255,0.06);
      --paper:       #f4f4f2;
      --ink:         #050505;
      --red:         #d90429;
      --red-bright:  #ef233c;
      --red-glow:    rgba(217,4,41,0.35);
      --rule:        rgba(255,255,255,0.08);
      --mono:        'IBM Plex Mono', monospace;
      --sans:        'Inter', sans-serif;
      --serif:       'Playfair Display', Georgia, serif;
      --ease:        cubic-bezier(0.16, 1, 0.3, 1);
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; background: var(--black); }
    body {
      font-family: var(--sans);
      font-size: 16px;
      letter-spacing: 0.01em;
      line-height: 1.6;
      color: var(--white);
      background: var(--black);
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }
    ::selection { background: var(--red); color: var(--white); }

    /* REVEAL */
    .reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.75s var(--ease), transform 0.75s var(--ease); }
    .reveal.in-view { opacity: 1; transform: translateY(0); }

    /* NAVBAR */
    .nav {
      position: fixed; top: 0; left: 0; width: 100%; z-index: 1000;
      display: flex; justify-content: space-between; align-items: center;
      padding: 1.25rem 4rem;
      background: rgba(5,5,5,0.9); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
      border-bottom: 1px solid var(--rule);
    }
    .nav__brand {
      font-family: var(--mono); font-size: 0.78rem; font-weight: 600;
      letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--white); text-decoration: none;
      display: flex; align-items: center; gap: 0.75rem;
    }
    .nav__brand-dot { width: 7px; height: 7px; background: var(--red); border-radius: 50%; box-shadow: 0 0 10px var(--red); }
    .nav__menu { display: flex; align-items: center; gap: 2.75rem; }
    .nav__link {
      font-family: var(--mono); font-size: 10px; text-transform: uppercase;
      letter-spacing: 0.2em; color: rgba(255,255,255,0.5);
      text-decoration: none; transition: color 0.25s ease; position: relative;
    }
    .nav__link::after {
      content: ''; position: absolute; left: 0; bottom: -3px;
      width: 0; height: 1px; background: var(--red); transition: width 0.3s var(--ease);
    }
    .nav__link:hover { color: var(--white); }
    .nav__link:hover::after { width: 100%; }
    .nav__toggle { display: none; background: none; border: none; color: var(--white); cursor: pointer; }
    .nav__toggle svg { width: 22px; height: 22px; fill: currentColor; }

    /* HERO */
    .hero {
      min-height: 94vh; display: grid; grid-template-columns: 1.15fr 0.85fr;
      align-items: center; padding: 10rem 4rem 7rem; max-width: 1440px; margin: 0 auto; gap: 5rem;
    }
    .hero__eyebrow { display: inline-flex; align-items: center; gap: 0.7rem; margin-bottom: 2.25rem; }
    .hero__eyebrow-line { width: 32px; height: 1px; background: var(--red); }
    .hero__eyebrow-text { font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.22em; color: var(--red); font-weight: 700; }
    .hero__title {
      font-family: var(--serif); font-size: clamp(4rem, 8.5vw, 8rem);
      letter-spacing: -0.045em; line-height: 0.88; font-weight: 900;
      margin-bottom: 2.5rem; color: var(--white);
    }
    .hero__title em { font-style: italic; color: var(--red); font-weight: 400; }
    .hero__desc {
      font-size: 1.05rem; line-height: 1.75; color: var(--white-dim);
      margin-bottom: 3.25rem; max-width: 500px;
      border-left: 2px solid var(--red); padding-left: 1.5rem;
    }
    .hero__actions { display: flex; flex-wrap: wrap; gap: 1rem; }
    .btn {
      font-family: var(--mono); font-size: 10px; text-transform: uppercase;
      letter-spacing: 0.18em; padding: 1.1rem 2rem;
      text-decoration: none; border: 1px solid rgba(255,255,255,0.3);
      color: var(--white); background: transparent; cursor: pointer;
      display: inline-flex; align-items: center; gap: 0.6rem;
      transition: all 0.3s var(--ease); font-weight: 600;
    }
    .btn--red { background: var(--red); border-color: var(--red); }
    .btn--red:hover { background: var(--red-bright); border-color: var(--red-bright); transform: translateY(-2px); box-shadow: 0 12px 30px var(--red-glow); }
    .btn:not(.btn--red):hover { background: var(--white); border-color: var(--white); color: var(--black); transform: translateY(-2px); }
    .hero__visual { display: flex; justify-content: flex-end; align-items: center; position: relative; }
    .hero__visual::before {
      content: ''; position: absolute; right: 14%; top: 50%; transform: translateY(-50%);
      width: clamp(320px, 34vw, 500px); aspect-ratio: 1; border-radius: 50%;
      border: 1px solid var(--red); opacity: 0.18; pointer-events: none;
    }
    .hero__img-frame {
      position: relative; width: clamp(300px, 33vw, 480px); aspect-ratio: 1/1;
      border-radius: 50%; padding: 12px;
      background: conic-gradient(from 180deg, var(--red) 0deg, transparent 90deg, rgba(255,255,255,0.08) 200deg, var(--red) 360deg);
    }
    .hero__img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; display: block; }

    /* METRICS STRIP */
    .metrics-strip { background: var(--black-card); border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
    .metrics-grid { max-width: 1440px; margin: 0 auto; display: grid; grid-template-columns: repeat(4, 1fr); }
    .metric-item { padding: 3.5rem 3rem; border-right: 1px solid var(--rule); position: relative; }
    .metric-item:last-child { border-right: none; }
    .metric-item::before {
      content: ''; position: absolute; left: 0; top: 0; width: 2px; height: 100%;
      background: var(--red); transform: scaleY(0); transform-origin: top;
      transition: transform 0.5s var(--ease);
    }
    .metric-item:hover::before { transform: scaleY(1); }
    .metric-item__val { font-family: var(--serif); font-size: 2.1rem; font-weight: 900; line-height: 1.05; margin-bottom: 0.5rem; letter-spacing: -0.03em; }
    .metric-item__val span { color: var(--red); }
    .metric-item__label { font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.18em; color: rgba(255,255,255,0.4); }

    /* TICKER */
    .ticker { background: var(--red); padding: 0.95rem 0; overflow: hidden; white-space: nowrap; }
    .ticker__track { display: inline-flex; gap: 4rem; animation: marquee 22s linear infinite; }
    .ticker__item { font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.28em; font-weight: 700; color: var(--white); display: flex; align-items: center; gap: 1rem; }
    .ticker__star { color: rgba(255,255,255,0.5); }
    @keyframes marquee { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

    /* SECTION HEADER */
    .sec-head { margin-bottom: 5.5rem; }
    .sec-head__eyebrow { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.25rem; }
    .sec-head__eyebrow-num { font-family: var(--mono); font-size: 10px; color: var(--red); letter-spacing: 0.12em; font-weight: 700; }
    .sec-head__eyebrow-rule { width: 48px; height: 1px; background: var(--red); }
    .sec-head__eyebrow-label { font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.22em; color: rgba(255,255,255,0.35); }
    .sec-head__title { font-family: var(--serif); font-size: clamp(3rem, 5.5vw, 5rem); letter-spacing: -0.04em; line-height: 0.93; font-weight: 900; }

    /* SECTION WRAPPER */
    .section { padding: 10rem 4rem; max-width: 1440px; margin: 0 auto; }
    .section-full { border-top: 1px solid var(--rule); }

    /* EDUCATION */
    .edu-grid { display: flex; flex-direction: column; gap: 1px; background: var(--rule); }
    .edu-card { background: var(--black-card); display: grid; grid-template-columns: 1.1fr 1fr; align-items: stretch; }
    .edu-card:nth-child(even) .edu-card__visual { order: 2; }
    .edu-card:nth-child(even) .edu-card__info { order: 1; }
    .edu-card__visual { min-height: 340px; background: #ffffff; display: flex; align-items: center; justify-content: center; padding: 3.5rem; position: relative; overflow: hidden; }
    .edu-card__visual img { max-height: 130px; max-width: 75%; object-fit: contain; filter: none !important; }
    .edu-card__tag { position: absolute; bottom: 1.5rem; left: 1.5rem; font-family: var(--mono); font-size: 9px; text-transform: uppercase; letter-spacing: 0.18em; padding: 0.4rem 0.9rem; background: var(--black); color: var(--white); font-weight: 600; border-left: 2px solid var(--red); }
    .edu-card__info { padding: 3.5rem 4rem; display: flex; flex-direction: column; justify-content: center; border-left: 1px solid var(--rule); }
    .edu-card:nth-child(even) .edu-card__info { border-left: none; border-right: 1px solid var(--rule); }
    .edu-card__seq { font-family: var(--mono); font-size: 10px; font-weight: 700; color: var(--red); letter-spacing: 0.14em; margin-bottom: 1rem; }
    .edu-card__school { font-family: var(--serif); font-size: clamp(2.2rem, 3.5vw, 3rem); letter-spacing: -0.04em; line-height: 0.95; margin-bottom: 0.75rem; font-weight: 900; }
    .edu-card__degree { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.12em; color: rgba(255,255,255,0.45); margin-bottom: 1.75rem; }
    .edu-card__desc { font-size: 1rem; line-height: 1.7; color: var(--white-dim); margin-bottom: 2rem; }
    .edu-card__pill { display: inline-flex; align-items: center; gap: 0.5rem; font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.14em; font-weight: 600; color: var(--white); border-top: 1px solid var(--rule); padding-top: 1.25rem; }
    .edu-card__pill span { color: var(--red); }

    /* EXPERIENCE */
    .exp-list { display: flex; flex-direction: column; gap: 1px; background: var(--rule); }
    .exp-card { background: var(--black-card); display: grid; grid-template-columns: 1.1fr 1fr; align-items: stretch; }
    .exp-card:nth-child(even) .exp-card__visual { order: 2; }
    .exp-card:nth-child(even) .exp-card__content { order: 1; }
    .exp-card__visual { min-height: 380px; overflow: hidden; position: relative; background: #121212; display: flex; align-items: center; justify-content: center; }
    .exp-card__visual--png { background: #ffffff !important; padding: 3rem; }
    .exp-card__visual--png img { object-fit: contain !important; max-height: 80%; max-width: 80%; filter: none !important; }
    .exp-card__visual img { width: 100%; height: 100%; object-fit: cover; filter: none !important; }
    .exp-card__badge { position: absolute; bottom: 1.5rem; left: 1.5rem; font-family: var(--mono); font-size: 9px; text-transform: uppercase; letter-spacing: 0.18em; padding: 0.4rem 0.9rem; background: rgba(5,5,5,0.9); border-left: 2px solid var(--red); color: var(--white); font-weight: 600; }
    .exp-card__content { padding: 3.5rem 4rem; display: flex; flex-direction: column; justify-content: center; border-left: 1px solid var(--rule); }
    .exp-card:nth-child(even) .exp-card__content { border-left: none; border-right: 1px solid var(--rule); }
    .exp-card__seq { font-family: var(--mono); font-size: 10px; font-weight: 700; color: var(--red); letter-spacing: 0.14em; margin-bottom: 1rem; }
    .exp-card__role { font-family: var(--serif); font-size: clamp(2.2rem, 3.5vw, 3rem); letter-spacing: -0.04em; line-height: 0.95; margin-bottom: 0.6rem; font-weight: 900; }
    .exp-card__company { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.12em; color: rgba(255,255,255,0.4); margin-bottom: 1.75rem; }
    .exp-card__desc { font-size: 1rem; line-height: 1.7; color: var(--white-dim); margin-bottom: 2rem; }
    .exp-card__tags { display: flex; flex-wrap: wrap; gap: 0.5rem; border-top: 1px solid var(--rule); padding-top: 1.5rem; }
    .exp-card__tag { font-family: var(--mono); font-size: 9px; text-transform: uppercase; letter-spacing: 0.14em; padding: 0.4rem 0.85rem; background: var(--white-ghost); color: rgba(255,255,255,0.55); }

    /* HACKATHONS */
    .hack-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--rule); }
    .hack-box { background: var(--black-card); padding: 5rem 4rem; position: relative; overflow: hidden; }
    .hack-box::after { content: attr(data-num); position: absolute; right: 2.5rem; bottom: -1rem; font-family: var(--serif); font-size: 9rem; font-weight: 900; color: rgba(255,255,255,0.03); line-height: 1; pointer-events: none; letter-spacing: -0.06em; }
    .hack-box__badge { display: inline-block; font-family: var(--mono); font-size: 9px; text-transform: uppercase; letter-spacing: 0.2em; padding: 0.4rem 0.9rem; background: var(--red); color: var(--white); font-weight: 700; margin-bottom: 2rem; }
    .hack-box__title { font-family: var(--serif); font-size: clamp(2.5rem, 4vw, 3.5rem); letter-spacing: -0.04em; line-height: 0.93; margin-bottom: 1.5rem; font-weight: 900; }
    .hack-box__text { font-size: 1rem; line-height: 1.7; color: var(--white-dim); max-width: 38ch; }

    /* PROJECTS */
    .proj-filters { display: flex; gap: 0; margin-bottom: 4.5rem; border: 1px solid var(--rule); width: fit-content; }
    .proj-filter-btn { font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.18em; padding: 0.85rem 1.75rem; background: transparent; border: none; border-right: 1px solid var(--rule); color: rgba(255,255,255,0.4); cursor: pointer; transition: all 0.25s ease; font-weight: 600; }
    .proj-filter-btn:last-child { border-right: none; }
    .proj-filter-btn.active { background: var(--white); color: var(--black); }
    .proj-filter-btn:not(.active):hover { color: var(--white); background: var(--white-ghost); }
    .proj-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--rule); }
    .proj-card { text-decoration: none; color: inherit; display: flex; flex-direction: column; background: var(--black-card); transition: opacity 0.4s ease; overflow: hidden; }
    .proj-card.hidden { display: none; }
    .proj-card__img-wrap { width: 100%; aspect-ratio: 16/10; min-height: 300px; overflow: hidden; background: #0f0f0f; display: flex; align-items: center; justify-content: center; }
    .proj-card__img-wrap--png { background: #ffffff !important; padding: 2.5rem; }
    .proj-card__img-wrap--png img { object-fit: contain !important; max-height: 80%; filter: none !important; }
    .proj-card__img-wrap img { width: 100%; height: 100%; object-fit: cover; filter: none !important; transition: transform 0.6s var(--ease); }
    .proj-card:hover .proj-card__img-wrap img { transform: scale(1.03); }
    .proj-card__info { padding: 2rem 2.5rem 2.5rem; display: flex; justify-content: space-between; align-items: flex-end; border-top: 1px solid var(--rule); flex: 1; }
    .proj-card__title { font-family: var(--serif); font-size: clamp(1.8rem, 2.5vw, 2.4rem); letter-spacing: -0.03em; line-height: 1.05; font-weight: 900; margin-bottom: 0.4rem; }
    .proj-card__sub { font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.14em; color: rgba(255,255,255,0.4); font-weight: 600; }
    .proj-card__sub span { color: var(--red); }
    .proj-card__arrow { font-size: 1.5rem; color: rgba(255,255,255,0.25); transition: transform 0.3s ease, color 0.3s ease; flex-shrink: 0; margin-left: 1rem; margin-bottom: 0.25rem; }
    .proj-card:hover .proj-card__arrow { transform: translate(4px, -4px); color: var(--red); }

    /* SKILLS */
    .skills-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--rule); }
    .skill-col { background: var(--black-card); padding: 3rem 2.5rem; }
    .skill-col__title { font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.22em; color: var(--red); margin-bottom: 2rem; font-weight: 700; padding-bottom: 1rem; border-bottom: 1px solid var(--rule); }
    .skill-tags { display: flex; flex-direction: column; gap: 0.9rem; }
    .skill-tag { font-family: var(--sans); font-size: 0.97rem; color: rgba(255,255,255,0.65); display: flex; align-items: center; gap: 0.75rem; }
    .skill-tag::before { content: ''; width: 16px; height: 1px; background: var(--red); flex-shrink: 0; }

    /* CONTACT */
    .contact-sec { padding: 10rem 4rem 8rem; background: var(--paper); color: var(--ink); }
    .contact-inner { max-width: 1400px; margin: 0 auto; display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 6rem; align-items: center; }
    .contact-big { font-family: var(--serif); font-size: clamp(3.5rem, 6vw, 6.5rem); letter-spacing: -0.045em; line-height: 0.9; color: var(--ink); font-weight: 900; }
    .contact-big em { color: var(--red); font-style: italic; }
    .contact-label { font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.22em; color: rgba(5,5,5,0.4); margin-bottom: 1.25rem; display: block; }
    .contact-links { display: flex; flex-direction: column; }
    .c-btn { display: flex; justify-content: space-between; align-items: center; padding: 1.6rem 2rem; background: transparent; border: 1px solid rgba(5,5,5,0.15); border-top: none; color: var(--ink); text-decoration: none; font-family: var(--mono); font-size: 12px; text-transform: uppercase; letter-spacing: 0.14em; font-weight: 600; cursor: pointer; transition: all 0.25s ease; }
    .c-btn:first-child { border-top: 1px solid rgba(5,5,5,0.15); }
    .c-btn:hover { background: var(--ink); color: var(--white); border-color: var(--ink); }
    .c-btn span:last-child { font-family: var(--mono); font-size: 10px; color: var(--red); letter-spacing: 0.18em; }
    .c-btn:hover span:last-child { color: var(--white); }

    /* FOOTER */
    .footer-bar { padding: 2.5rem 4rem; background: var(--black); color: rgba(255,255,255,0.35); display: flex; justify-content: space-between; align-items: center; font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.18em; border-top: 1px solid var(--rule); }
    .footer-links { display: flex; gap: 2rem; }
    .footer-links a { color: rgba(255,255,255,0.35); text-decoration: none; transition: color 0.2s ease; }
    .footer-links a:hover { color: var(--red); }

    /* TOAST */
    .toast { position: fixed; bottom: 2.5rem; right: 2.5rem; background: var(--black); border: 1px solid var(--red); color: var(--white); padding: 1rem 1.75rem; font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.14em; font-weight: 600; box-shadow: 0 0 30px var(--red-glow); transform: translateY(110px); opacity: 0; transition: all 0.4s var(--ease); z-index: 3000; }
    .toast.show { transform: translateY(0); opacity: 1; }

    /* RESPONSIVE */
    @media (max-width: 1024px) {
      .hero { grid-template-columns: 1fr; text-align: center; gap: 3rem; padding-top: 8rem; }
      .hero__eyebrow, .hero__actions { justify-content: center; }
      .hero__desc { margin: 0 auto 3rem; max-width: 500px; border-left: none; border-top: 2px solid var(--red); padding-left: 0; padding-top: 1.5rem; }
      .hero__visual { justify-content: center; }
      .hero__visual::before { right: 50%; transform: translate(50%, -50%); }
      .metrics-grid { grid-template-columns: repeat(2, 1fr); }
      .metric-item:nth-child(2n) { border-right: none; }
      .edu-card { grid-template-columns: 1fr; }
      .edu-card__visual { min-height: 260px; }
      .edu-card:nth-child(even) .edu-card__visual, .edu-card:nth-child(even) .edu-card__info { order: initial; }
      .edu-card__info { border-left: none; border-top: 1px solid var(--rule); padding: 2.5rem; }
      .edu-card:nth-child(even) .edu-card__info { border-right: none; }
      .exp-card { grid-template-columns: 1fr; }
      .exp-card:nth-child(even) .exp-card__visual, .exp-card:nth-child(even) .exp-card__content { order: initial; }
      .exp-card__content { border-left: none; border-top: 1px solid var(--rule); padding: 2.5rem; }
      .exp-card:nth-child(even) .exp-card__content { border-right: none; }
      .skills-grid { grid-template-columns: repeat(2, 1fr); }
      .contact-inner { grid-template-columns: 1fr; gap: 4rem; }
    }
    @media (max-width: 768px) {
      .nav__menu { display: none; position: fixed; top: 58px; left: 0; width: 100%; background: rgba(5,5,5,0.98); flex-direction: column; padding: 2.5rem; gap: 1.5rem; border-bottom: 2px solid var(--red); }
      .nav__menu.active { display: flex; }
      .nav__toggle { display: block; }
      .section { padding: 6rem 1.5rem; }
      .contact-sec { padding: 6rem 1.5rem; }
